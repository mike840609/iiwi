+        executable=cli_settings.executable,
+        model=cli_settings.model,
+    )
+    result = OutcomeSynthesisService(runner).synthesize(scan)
+    arguments: dict[str, object] = {
+        "outcomes": result.outcomes,
+        "report_type": draft.report_type,
