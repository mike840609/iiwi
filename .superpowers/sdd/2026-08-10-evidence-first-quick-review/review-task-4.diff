+    second_log = ActionLog(overridden)
+    _run(
+        monkeypatch,
+        draft,
+        second_log,
+        [
+            *_open_review_keys(),
+            KeyPress(key=Key.ENTER),
+            KeyPress(key=Key.ENTER),
+            char("b"),
+            char("q"),
+            char("q"),
+        ],
+    )
+
