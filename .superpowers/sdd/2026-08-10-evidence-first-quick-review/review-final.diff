+    attempts = 0
+
+    def synthesize(current: ReportDraft, selected_scan: ScanResult) -> OutcomeReviewDraft:
+        nonlocal attempts
+        attempts += 1
+        if attempts == 1:
+            raise OutcomeSynthesisError("temporary synthesis failure")
+        return review
+
+    screens, output = _run(
+        draft,
